<%# locals: (budget:) %>

<div>
  <div class="flex items-center gap-1.5 px-4 py-2 text-xs font-medium text-secondary uppercase">
    <p>Kategórie</p>
    <span class="text-subdued">&middot;</span>
    <p><%= budget.budget_categories.count %></p>

    <p class="ml-auto">Suma</p>
  </div>

  <div class="bg-container py-1 shadow-border-xs rounded-md">
    <% if budget.family.categories.expenses.empty? %>
      <div class="py-8">
        <%= render "budget_categories/no_categories" %>
      </div>
    <% else %>
      <% visible_groups, hidden_groups = BudgetCategory::Group.split_by_relevance(budget.budget_categories) %>

      <% visible_groups.each do |group| %>
        <%= render "budgets/budget_category_group", group: group %>
      <% end %>

      <% if hidden_groups.any? %>
        <%= render layout: "shared/show_more_disclosure", locals: { count: hidden_groups.size } do %>
          <% hidden_groups.each do |group| %>
            <%= render "budgets/budget_category_group", group: group %>
          <% end %>
        <% end %>
      <% end %>

      <%= render "budget_categories/budget_category", budget_category: budget.uncategorized_budget_category %>
    <% end %>
  </div>
</div>
