<%# locals: (import:) %>

<%= styled_form_with model: @import, url: import_configuration_path(@import), scope: :import, method: :patch, class: "space-y-4" do |form| %>
  <div class="space-y-4">
    <div class="flex items-center gap-4">
      <%= form.select :date_col_label, import.csv_headers, { include_blank: "Vyberte stĺpec", label: "Dátum" }, required: true %>
      <%= form.select :date_format, Family::DATE_FORMATS, { label: t(".date_format_label")}, label: true, required: true %>
    </div>

    <div class="flex items-center gap-4">
      <%= form.select :qty_col_label, import.csv_headers, { include_blank: "Vyberte stĺpec", label: "Množstvo" }, required: true %>
      <%= form.select :signage_convention, [["Nákupy sú kladné množstvo", "inflows_positive"], ["Nákupy sú záporné množstvo", "inflows_negative"]], label: true, required: true %>
    </div>

    <div class="flex items-center gap-4">
      <%= form.select :currency_col_label, import.csv_headers, { include_blank: "Predvolená", label: "Mena" } %>
      <%= form.select :number_format, Import::NUMBER_FORMATS.keys, { label: "Formát", prompt: "Vyberte formát" }, required: true %>
    </div>

    <%= form.select :ticker_col_label, import.csv_headers, { include_blank: "Vyberte stĺpec", label: "Tiker" }, required: true %>
    <%= form.select :exchange_operating_mic_col_label, import.csv_headers, { include_blank: "Nechať prázdne", label: "Kód burzy" } %>
    <%= form.select :price_col_label, import.csv_headers, { include_blank: "Vyberte stĺpec", label: "Cena" }, required: true %>

    <% unless import.account.present? %>
      <%= form.select :account_col_label, import.csv_headers, { include_blank: "Nechať prázdne", label: "Účet" } %>
    <% end %>

    <%= form.select :name_col_label, import.csv_headers, { include_blank: "Nechať prázdne", label: "Názov" } %>
  </div>

  <%= form.submit "Použiť konfiguráciu", disabled: import.complete? %>
<% end %>
