<%# locals: (import:) %>

<div class="flex items-center justify-between border border-secondary rounded-lg bg-green-500/5 p-5 gap-4 mb-4">
  <span class="text-green-500">
    <%= icon("check-circle", color: "current") %>
  </span>
  <p class="text-sm text-primary italic">Váš import z Mintu sme za vás vopred nastavili. Pokračujte, prosím, na ďalší krok.</p>
</div>

<%= styled_form_with model: @import, url: import_configuration_path(@import), scope: :import, method: :patch, class: "space-y-4" do |form| %>
  <div class="flex items-center gap-4">
    <%= form.select :date_col_label, import.csv_headers, { include_blank: "Nechať prázdne", label: "Dátum" }, required: true, disabled: import.complete? %>
    <%= form.select :date_format, Family::DATE_FORMATS, { label: t(".date_format_label")}, label: true, required: true, disabled: import.complete? %>
  </div>

  <div class="flex items-center gap-4">
    <%= form.select :amount_col_label, import.csv_headers, { include_blank: "Nechať prázdne", label: "Suma" }, required: true, disabled: import.complete? %>
    <%= form.select :signage_convention, [["Príjmy sú záporné", "inflows_negative"], ["Príjmy sú kladné", "inflows_positive"]], { label: true }, disabled: import.complete? %>
  </div>

  <div class="flex items-center gap-4">
    <%= form.select :currency_col_label, import.csv_headers, { include_blank: "Nechať prázdne", label: "Mena" }, disabled: import.complete? %>
    <%= form.select :number_format, Import::NUMBER_FORMATS.keys, { label: "Formát", prompt: "Vyberte formát" }, required: true %>
  </div>

  <% unless import.account.present? %>
    <%= form.select :account_col_label, import.csv_headers, { include_blank: "Nechať prázdne", label: "Účet (nepovinné)" }, disabled: import.complete? %>
  <% end %>

  <%= form.select :name_col_label, import.csv_headers, { include_blank: "Nechať prázdne", label: "Názov (nepovinné)" }, disabled: import.complete? %>
  <%= form.select :category_col_label, import.csv_headers, { include_blank: "Nechať prázdne", label: "Kategória (nepovinné)" }, disabled: import.complete? %>
  <%= form.select :tags_col_label, import.csv_headers, { include_blank: "Nechať prázdne", label: "Štítky (nepovinné)" }, disabled: import.complete? %>

  <%= form.submit "Použiť konfiguráciu", disabled: import.complete? %>
<% end %>
