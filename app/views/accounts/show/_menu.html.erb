<%# locals: (account:) %>

<%= render DS::Menu.new(testid: "account-menu") do |menu| %>
  <% menu.with_item(variant: "link", text: "Upraviť", href: edit_account_path(account), icon: "pencil-line", data: { turbo_frame: :modal }) %>

  <% unless account.crypto? %>
    <% menu.with_item(
      variant: "link",
      text: "Importovať transakcie",
      href: imports_path({ import: { type: account.investment? ? "TradeImport" : "TransactionImport", account_id: account.id } }),
      icon: "download",
      data: { turbo_frame: :_top }
    ) %>
  <% end %>

  <% menu.with_item(
    variant: "button",
    text: "Zmazať účet",
    href: account_path(account),
    method: :delete,
    icon: "trash-2",
    confirm: CustomConfirm.for_resource_deletion("tento účet", high_severity: true),
    data: { turbo_frame: :_top }
  ) %>
<% end %>
