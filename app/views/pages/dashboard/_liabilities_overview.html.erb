<%# locals: (overview:) %>
<section class="space-y-4">
  <div class="flex items-center justify-between">
    <h2 class="text-lg font-medium text-primary">
      Záväzky
      <% if overview.liability_accounts.any? %>
        <span class="text-secondary font-normal">· <%= overview.liabilities_total_money.format %></span>
      <% end %>
    </h2>
    <%= render DS::Link.new(text: "Pridať", icon: "plus", href: new_liability_path, frame: :modal) %>
  </div>

  <% if overview.liability_accounts.any? %>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
      <% overview.liability_accounts.each do |account| %>
        <% last_payment = overview.last_payment_for(account) %>

        <div class="bg-container rounded-xl shadow-border-xs p-5 border border-secondary">
          <div class="flex items-start gap-3 mb-3">
            <%= render DS::FilledIcon.new(variant: :surface, icon: account.accountable.icon) %>
            <div class="min-w-0 flex-1">
              <p class="font-medium text-primary"><%= account.name %></p>
              <p class="text-xs text-secondary"><%= loan_subtype_label(account) %></p>
            </div>
            <p class="text-lg font-medium text-destructive shrink-0"><%= account.balance_money.format %></p>
          </div>

          <% if last_payment %>
            <p class="text-xs text-secondary mb-3">Posledná platba: <%= entry_date_label(last_payment.date) %></p>
          <% end %>

          <div class="flex gap-2">
            <%= render DS::Link.new(
              text: "Upraviť",
              icon: "pencil",
              href: edit_liability_path(account),
              frame: :modal,
              variant: "outline"
            ) %>
            <%= render DS::Link.new(
              text: "Platby",
              href: account_path(account),
              variant: "ghost"
            ) %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="bg-container rounded-xl shadow-border-xs p-8 flex flex-col items-center text-center">
      <%= render DS::FilledIcon.new(variant: :container, icon: "hand-coins") %>
      <p class="text-sm font-medium text-primary mt-3">Zatiaľ nemáte žiadne záväzky</p>
      <p class="text-secondary text-sm mb-4 max-w-sm">Pôžička od kamaráta, leasing auta alebo hypotéka — stačí názov a suma, ktorú dlžíte.</p>
      <%= render DS::Link.new(text: "Pridať záväzok", icon: "plus", href: new_liability_path, frame: :modal) %>
    </div>
  <% end %>
</section>
