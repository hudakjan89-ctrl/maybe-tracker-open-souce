<%# locals: (entries:) %>
<section class="bg-container rounded-xl shadow-border-xs overflow-hidden">
  <div class="flex items-center justify-between p-5 pb-0">
    <h2 class="text-lg font-medium text-primary">Posledné transakcie</h2>
    <%= render DS::Link.new(text: "Všetky", href: transactions_path) %>
  </div>

  <% if entries.any? %>
    <div class="p-2">
      <% entries.each do |entry| %>
        <% transaction = entry.entryable %>
        <% category = transaction.respond_to?(:category) ? transaction.category : nil %>

        <%= link_to transaction_path(entry), class: "flex items-center gap-3 p-3 rounded-xl hover:bg-surface-hover transition-colors group", data: { turbo_frame: "_top" } do %>
          <div class="w-1 self-stretch rounded-full shrink-0" style="background-color: <%= category&.color || '#737373' %>"></div>

          <%= render "shared/entry_avatar", entry: entry, size: "md" %>

          <div class="min-w-0 flex-1">
            <p class="text-sm font-medium text-primary truncate group-hover:text-primary"><%= entry.name %></p>
            <p class="text-xs text-secondary">
              <%= entry_date_label(entry.date) %>
              <% if category %>
                · <%= category.name %>
              <% end %>
            </p>
          </div>

          <div class="shrink-0 text-right">
            <%= entry_amount_display(entry) %>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <p class="text-sm text-secondary text-center py-8">Zatiaľ žiadne transakcie</p>
  <% end %>
</section>
