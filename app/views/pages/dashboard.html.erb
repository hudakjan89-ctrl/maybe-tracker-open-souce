<% content_for :page_header do %>
  <div class="space-y-1 mb-6 flex gap-4 justify-between items-center lg:items-start">

    <div class="space-y-1">
      <h1 class="text-xl lg:text-3xl font-medium text-primary">Vitajte späť, <%= Current.user.first_name %></h1>
      <p class="text-sm lg:text-base text-secondary">Tu je prehľad vašich financií</p>
    </div>

    <div class="flex items-center gap-2">
      <%= button_to demo_transactions_path, method: :post, class: "inline-flex items-center gap-1.5 px-3 py-2 text-sm font-medium rounded-lg bg-container-inset border border-secondary text-secondary hover:text-primary hover:bg-surface-hover transition-colors" do %>
        <%= icon("zap", size: "sm") %>
        Testing — ukážkové dáta
      <% end %>

      <%= render DS::Link.new(
        icon: "plus",
        text: "Nové",
        href: new_account_path,
        frame: :modal,
        class: "hidden lg:inline-flex"
      ) %>

      <%= render DS::Link.new(
        variant: "icon-inverse",
        icon: "plus",
        href: new_account_path,
        frame: :modal,
        class: "rounded-full lg:hidden"
      ) %>
    </div>
  </div>
<% end %>

<div class="w-full space-y-6 pb-24">
  <% if Current.family.accounts.any? %>
    <%= render "pages/dashboard/summary_cards", month_income: @month_income, month_expense: @month_expense %>

    <%= render "pages/dashboard/cash_overview", overview: @dashboard, period: @period %>

    <%= render "pages/dashboard/budget_summary", budget: @current_budget %>

    <%= render "pages/dashboard/liabilities_overview", overview: @dashboard %>

    <%= render "pages/dashboard/recent_transactions", entries: @recent_entries %>

    <%= render "pages/dashboard/spending_breakdown",
          expense_totals: @spending_expense,
          income_totals: @spending_income,
          period: @cashflow_period %>
  <% else %>
    <section>
      <%= render "pages/dashboard/no_accounts_graph_placeholder" %>
    </section>
  <% end %>
</div>
