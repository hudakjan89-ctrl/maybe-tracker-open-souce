<%= render DS::Dialog.new(reload_on_close: true) do |dialog| %>
  <%
    title = if @rule.name.present?
              "Potvrdiť zmeny v pravidle „#{@rule.name}“"
            else
              "Potvrdiť zmeny"
            end
  %>
  <% dialog.with_header(title: title) %>

  <% dialog.with_body do %>
    <p class="text-secondary text-sm mb-4">
      Toto pravidlo sa použije na
      <span class="text-primary font-medium"><%= @rule.affected_resource_count %> transakcií</span>,
      ktoré spĺňajú zadané podmienky. Potvrďte, či chcete pokračovať.
    </p>

    <%= render DS::Button.new(
      text: "Potvrdiť zmeny",
      href: apply_rule_path(@rule),
      method: :post,
      full_width: true,
      data: { turbo_frame: "_top" }) %>
  <% end %>
<% end %>
