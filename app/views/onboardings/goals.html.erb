<%= content_for :previous_path, preferences_onboarding_path %>

<%= content_for :header_nav do %>
  <%= render "onboardings/onboarding_nav", user: @user %>
<% end %>

<%= content_for :cancel_action do %>
  <%= render "onboardings/logout" %>
<% end %>

<%= content_for :footer do %>
  <%= render "layouts/shared/footer" %>
<% end %>

<div class="grow max-w-lg w-full mx-auto bg-surface flex flex-col justify-center md:py-0 py-6 px-4 md:px-0">
  <div>
    <div class="space-y-1 mb-6 text-center">
      <h1 class="text-2xl font-medium md:text-2xl">Aké máte ciele?</h1>
      <p class="text-secondary text-sm">Vyberte jeden alebo viac cieľov pre váš rozpočet.</p>
    </div>

    <%= form_with model: @user do |form| %>
      <%= form.hidden_field :redirect_to, value: "home" %>
      <%= form.hidden_field :set_onboarding_goals_at, value: Time.current %>
      <%= form.hidden_field :onboarded_at, value: Time.current %>

      <div class="space-y-3">
        <% [
          { icon: "layers", label: "Vidieť všetky účty na jednom mieste", value: "unified_accounts" },
          { icon: "banknote", label: "Rozumieť príjmom a výdavkom", value: "cashflow" },
          { icon: "pie-chart", label: "Plánovať rozpočet", value: "budgeting" },
          { icon: "users", label: "Spravovať financie s partnerom", value: "partner" },
          { icon: "area-chart", label: "Sledovať investície", value: "investments" },
          { icon: "settings-2", label: "Analyzovať a optimalizovať účty", value: "optimization" },
          { icon: "frown", label: "Znížiť finančný stres", value: "reduce_stress" }
        ].each do |goal| %>
          <label class="flex items-center gap-2.5 p-4 rounded-lg border border-tertiary cursor-pointer hover:bg-container transition-colors [&:has(input:checked)]:border-solid [&:has(input:checked)]:bg-container">
            <%= form.check_box :goals, { multiple: true, class: "sr-only" }, goal[:value], nil %>
            <%= icon goal[:icon] %>
            <span class="text-primary text-sm"><%= goal[:label] %></span>
          </label>
        <% end %>
      </div>

      <div class="mt-6">
        <%= render DS::Button.new(
          text: "Začať",
          full_width: true
        ) %>
      </div>
    <% end %>
  </div>
</div>
