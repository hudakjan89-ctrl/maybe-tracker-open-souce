<%= content_for :header_nav do %>
  <%= render "budgets/budget_nav", budget: @budget %>
<% end %>

<%= content_for :previous_path, edit_budget_path(@budget) %>
<%= content_for :cancel_path, budget_path(@budget) %>

<div>
  <div class="space-y-6">
    <div class="text-center space-y-2">
      <h1 class="text-3xl text-primary font-medium">Rozdelenie do kategórií</h1>
      <p class="text-secondary text-sm max-w-md mx-auto">
        Nastavte limit pre každú kategóriu. Nerozdelené peniaze sa automaticky pridajú do „Bez kategórie“.
      </p>
    </div>

    <div class="mx-auto max-w-lg">
      <% if @budget.family.categories.empty? %>
        <div class="bg-container shadow-border-xs rounded-lg p-4">
          <%= render "budget_categories/no_categories" %>
        </div>
      <% else %>
        <div class="max-w-md mx-auto">
          <%= render "budget_categories/allocation_progress", budget: @budget %>

          <% visible_groups, hidden_groups = BudgetCategory::Group.split_by_relevance(@budget_categories) %>

          <div class="space-y-4 mb-4">
            <% visible_groups.each do |group| %>
              <%= render "budget_categories/group_form", group: group %>
            <% end %>

            <% if hidden_groups.any? %>
              <%= render layout: "shared/show_more_disclosure", locals: { count: hidden_groups.size } do %>
                <div class="space-y-4 pt-1">
                  <% hidden_groups.each do |group| %>
                    <%= render "budget_categories/group_form", group: group %>
                  <% end %>
                </div>
              <% end %>
            <% end %>

            <div class="pt-2">
              <%= render DS::Link.new(
                text: "Pridať kategóriu",
                icon: "plus",
                href: new_category_path,
                frame: :modal,
                variant: "outline",
                full_width: true
              ) %>
            </div>

            <%= render "budget_categories/uncategorized_budget_category_form", budget: @budget %>
          </div>

          <%= render "budget_categories/confirm_button", budget: @budget %>
        </div>
      <% end %>
    </div>
  </div>
</div>
