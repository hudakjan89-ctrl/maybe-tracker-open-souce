<div class="flex justify-center items-center">
  <div class="text-center flex flex-col items-center max-w-[500px]">
    <h2 class="text-lg text-primary font-medium">Zatiaľ nemáte kategórie</h2>
    <p class="text-secondary text-sm max-w-sm mx-auto mb-4">
      Rozpočet funguje podľa kategórií výdavkov. Najprv vytvorte kategórie alebo použite predvolené.
    </p>

    <div class="flex items-center gap-2">
      <%= render DS::Button.new(
        text: "Predvolené kategórie",
        href: bootstrap_categories_path,
      ) %>

      <%= render DS::Link.new(
        text: "Nová kategória",
        variant: "outline",
        icon: "plus",
        href: new_category_path,
        frame: :modal,
      ) %>
    </div>
  </div>
</div>
