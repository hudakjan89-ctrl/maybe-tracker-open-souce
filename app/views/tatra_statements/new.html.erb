<%= render DS::Dialog.new do |dialog| %>
  <% dialog.with_header(title: "Výpis z Tatra banky", subtitle: "Nahrajte PDF výpis alebo históriu pohybov. Importuje sa každá transakcia, nič sa nevynechá.") %>

  <% dialog.with_body do %>
    <% if @accounts.empty? %>
      <div class="p-4 space-y-3">
        <p class="text-sm text-secondary">Najprv vytvorte účet (napríklad bežný účet v Tatra banke) a potom sem vložte výpis.</p>
        <%= render DS::Link.new(text: "Pridať účet", icon: "plus", href: new_account_path, frame: :modal, variant: "primary") %>
      </div>
    <% else %>
        <%= render DS::Alert.new(message: flash[:alert], variant: :error) if flash[:alert].present? %>

      <%= styled_form_with url: tatra_statement_path, method: :post, multipart: true, data: { turbo_frame: :_top }, class: "space-y-4" do |form| %>
        <%= form.collection_select :account_id,
              @accounts, :id, :name,
              { label: "Účet", selected: @accounts.first.id },
              { name: "account_id", required: true } %>

        <div class="flex flex-col items-center justify-center w-full min-h-40 border border-secondary border-dashed rounded-xl cursor-pointer px-4 py-6"
             data-controller="file-upload"
             data-action="click->file-upload#triggerFileInput"
             data-file-upload-target="uploadArea">
          <div data-file-upload-target="uploadText" class="flex flex-col items-center text-center">
            <%= icon("file-text", size: "lg", class: "mb-3") %>
            <p class="text-sm text-primary font-medium">Kliknite a vyberte PDF výpis</p>
            <p class="text-xs text-secondary mt-1">PDF z internet bankingu, prípadne CSV alebo TXT</p>
          </div>
          <div class="flex flex-col gap-2 items-center hidden" data-file-upload-target="fileName">
            <%= icon("file-text", size: "lg") %>
            <p class="text-sm font-medium text-primary"></p>
          </div>
          <%= form.file_field :statement,
                name: "statement",
                accept: ".pdf,.csv,.txt,application/pdf,text/csv,text/plain",
                required: true,
                class: "hidden",
                data: { file_upload_target: "input" } %>
        </div>

        <p class="text-xs text-secondary">
          V Tatra banke: Účty → História pohybov / Výpisy → stiahnuť PDF. Po importe uvidíte všetky pohyby v Transakciách.
        </p>

        <%= form.submit "Importovať výpis" %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
