<%= render DS::Dialog.new do |dialog| %>
  <% dialog.with_header(title: "Vložiť výpis z Tatra banky", subtitle: "Stačí položiť CSV alebo PDF. Transakcie sa samy roztriedia na #{@account&.name || "váš účet"}.") %>

  <% dialog.with_body do %>
    <% if @account.nil? %>
      <div class="p-4 space-y-3">
        <p class="text-sm text-secondary">Najprv vytvorte účet (napríklad Hlavný účet) a potom sem vložte výpis.</p>
        <%= render DS::Link.new(text: "Pridať účet", icon: "plus", href: new_account_path, frame: :modal, variant: "primary") %>
      </div>
    <% else %>
      <%= render DS::Alert.new(message: flash[:alert], variant: :error) if flash[:alert].present? %>

      <%= styled_form_with url: tatra_statement_path, method: :post, multipart: true, data: { turbo_frame: :_top }, class: "space-y-4" do |form| %>
        <%= hidden_field_tag :account_id, @account.id %>

        <div class="flex flex-col items-center justify-center w-full min-h-48 border border-secondary border-dashed rounded-xl cursor-pointer px-4 py-8"
             data-controller="file-upload"
             data-file-upload-autosubmit-value="true"
             data-action="click->file-upload#triggerFileInput dragover->file-upload#dragOver drop->file-upload#drop dragleave->file-upload#dragLeave"
             data-file-upload-target="uploadArea">
          <div data-file-upload-target="uploadText" class="flex flex-col items-center text-center">
            <%= icon("file-text", size: "lg", class: "mb-3") %>
            <p class="text-sm text-primary font-medium">Položte sem výpis alebo kliknite a vyberte súbor</p>
            <p class="text-xs text-secondary mt-1">CSV z Histórie pohybov, prípadne PDF. Nič iné nastavovať nemusíte.</p>
          </div>
          <div class="flex flex-col gap-2 items-center hidden" data-file-upload-target="fileName">
            <%= icon("file-text", size: "lg") %>
            <p class="text-sm font-medium text-primary"></p>
            <p class="text-xs text-secondary">Nahrávam a spracúvam výpis…</p>
          </div>
          <%= form.file_field :statement,
                name: "statement",
                accept: ".pdf,.csv,.txt,application/pdf,text/csv,text/plain,text/comma-separated-values",
                required: true,
                class: "hidden",
                data: { file_upload_target: "input" } %>
        </div>
      <% end %>
    <% end %>
  <% end %>
<% end %>
