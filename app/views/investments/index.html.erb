<% content_for :page_header do %>
  <div class="space-y-1 mb-6 flex gap-4 justify-between items-center">
    <div class="space-y-1">
      <h1 class="text-xl lg:text-3xl font-medium text-primary">Investície</h1>
      <p class="text-sm lg:text-base text-secondary">Prehľad investičných účtov a portfólia</p>
    </div>

    <%= render DS::Link.new(
      icon: "plus",
      text: "Nový účet",
      href: new_investment_path,
      frame: :modal,
      class: "hidden lg:inline-flex"
    ) %>
  </div>
<% end %>

<div class="w-full space-y-6 pb-24">
  <% if @investment_accounts.any? %>
    <section class="bg-container p-5 rounded-xl shadow-border-xs">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-medium text-primary">Celková hodnota portfólia</h2>
        <span class="text-2xl font-medium text-primary">
          <%= Money.new(@total_value, @currency).format %>
        </span>
      </div>
    </section>

    <section class="space-y-4">
      <% @investment_accounts.each do |account| %>
        <%= link_to account_path(account), class: "block bg-container p-5 rounded-xl shadow-border-xs hover:bg-container-inset transition-colors" do %>
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-3">
              <%= render DS::FilledIcon.new(variant: :surface, icon: "line-chart") %>
              <div>
                <h3 class="font-medium text-primary"><%= account.name %></h3>
                <p class="text-sm text-secondary">
                  <%= account.current_holdings.count %> pozícií
                </p>
              </div>
            </div>
            <div class="text-right">
              <p class="font-medium text-primary"><%= account.balance_money.format %></p>
              <p class="text-xs text-secondary">Hotovosť: <%= account.cash_balance_money.format %></p>
            </div>
          </div>

          <% if account.current_holdings.any? %>
            <div class="mt-4 pt-4 border-t border-secondary">
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
                <% account.current_holdings.first(3).each do |holding| %>
                  <div class="flex items-center justify-between text-sm">
                    <span class="text-secondary"><%= holding.security.ticker %></span>
                    <span class="text-primary font-medium"><%= holding.qty %> ks</span>
                  </div>
                <% end %>
                <% if account.current_holdings.count > 3 %>
                  <p class="text-xs text-secondary">+ <%= account.current_holdings.count - 3 %> ďalších</p>
                <% end %>
              </div>
            </div>
          <% end %>
        <% end %>
      <% end %>
    </section>
  <% else %>
    <section class="bg-container py-12 rounded-xl shadow-border-xs flex flex-col items-center justify-center">
      <%= render DS::FilledIcon.new(variant: :container, icon: "line-chart") %>
      <p class="text-sm font-medium text-primary mt-3">Zatiaľ nemáte žiadne investičné účty</p>
      <p class="text-secondary text-sm mb-4">Vytvorte investičný účet alebo použite tlačidlo Testing</p>
      <%= render DS::Link.new(
        text: "Vytvoriť investičný účet",
        icon: "plus",
        href: new_investment_path,
        frame: :modal
      ) %>
    </section>
  <% end %>
</div>
