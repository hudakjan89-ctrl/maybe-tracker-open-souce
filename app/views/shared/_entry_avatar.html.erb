<%# locals: (entry:, size: "md") %>
<% transaction = entry.entryable %>
<% category = transaction.respond_to?(:category) ? transaction.category : nil %>
<% merchant = transaction.respond_to?(:merchant) ? transaction.merchant : nil %>
<% logo_url = merchant&.logo_url.presence || Merchant::LogoUrl.for(entry.name) %>
<% emoji = Merchant::LogoUrl.emoji_for(entry.name) %>
<% size_classes = { "sm" => "w-8 h-8 text-sm", "md" => "w-10 h-10 text-base", "lg" => "w-12 h-12 text-lg" } %>
<% dims = size_classes.fetch(size, size_classes["md"]) %>

<% if logo_url.present? %>
  <%= image_tag logo_url,
        class: "#{dims.split.first(2).join(' ')} rounded-full object-cover bg-container-inset shrink-0",
        loading: "lazy",
        alt: entry.name,
        onerror: "this.style.display='none'; this.nextElementSibling?.classList.remove('hidden')" %>
  <div class="hidden <%= dims %> rounded-full shrink-0 flex items-center justify-center font-medium"
       style="background-color: <%= hex_with_alpha(category&.color || '#737373', 0.15) %>; color: <%= category&.color || '#737373' %>">
    <% if emoji.present? %>
      <%= emoji %>
    <% elsif category&.lucide_icon.present? %>
      <%= icon category.lucide_icon, size: "sm", color: "current" %>
    <% else %>
      <%= entry.name.first.upcase %>
    <% end %>
  </div>
<% elsif emoji.present? %>
  <div class="<%= dims %> rounded-full shrink-0 flex items-center justify-center bg-container-inset">
    <%= emoji %>
  </div>
<% elsif category&.lucide_icon.present? %>
  <div class="<%= dims %> rounded-full shrink-0 flex items-center justify-center"
       style="background-color: <%= hex_with_alpha(category.color, 0.15) %>; color: <%= category.color %>">
    <%= icon category.lucide_icon, size: "sm", color: "current" %>
  </div>
<% else %>
  <div class="<%= dims %> rounded-full shrink-0 flex items-center justify-center font-medium"
       style="background-color: <%= hex_with_alpha(category&.color || '#737373', 0.15) %>; color: <%= category&.color || '#737373' %>">
    <%= entry.name.first.upcase %>
  </div>
<% end %>
